<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata. Not strictly required for a side-loaded bundle, but it is what
  a software centre reads to describe the app, and it is the first thing Flathub's
  linter checks — so it is cheaper to have now than to retrofit.

  `project_license` is a licence declaration inside a distributable package, not a
  formality: this repository's LICENSE is the GNU Affero General Public License v3.
  `-only` rather than `-or-later` is the conservative reading of a bare LICENSE file
  with no per-file "or any later version" notice anywhere in the tree.
-->
<component type="desktop-application">
  <id>io.github.adsouza.armchair-metropolist</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <name>Armchair Metropolist</name>
  <summary>City infrastructure simulator</summary>

  <description>
    <p>
      Zone land, lay transit, and watch a city grow or stall. Power, water, waste,
      traffic, labour and money are recomputed every tick as demand against capacity,
      and a starved block loses health until it goes offline — which removes its own
      contribution and starves its neighbours further.
    </p>
    <p>
      Money is the only resource whose surplus survives the tick boundary, so a city
      can read fully satisfied on the other five and still be quietly going broke.
      There are two ways to lose and the fast one arrives early.
    </p>
  </description>

  <launchable type="desktop-id">io.github.adsouza.armchair-metropolist.desktop</launchable>

  <url type="homepage">https://github.com/adsouza/armchair-metropolist</url>
  <url type="bugtracker">https://github.com/adsouza/armchair-metropolist/issues</url>

  <!-- No violence, no chat, no purchases, no data collection. All-ages. -->
  <content_rating type="oars-1.1" />

  <releases>
    <!--
      0.1.0 was never published, so this is the first release users can install
      and the notes describe what it *is* rather than what changed.

      Adding a <description> makes this entry a container rather than a
      self-closing tag. `mix version.set` handles both — see the @release_open
      comment in lib/mix/tasks/version.set.ex, which explains why an earlier
      version would have inserted the next release *underneath* this one.
    -->
    <release version="0.7.0" date="2026-08-11" />
    <release version="0.6.0" date="2026-08-10" />
    <release version="0.5.2" date="2026-08-10" />
    <release version="0.5.1" date="2026-08-09" />
    <release version="0.5.0" date="2026-08-09" />
    <release version="0.4.0" date="2026-08-09" />
    <release version="0.3.0" date="2026-08-08" />
    <release version="0.2.0" date="2026-08-05">
      <description>
        <p>First installable release.</p>
        <ul>
          <li>
            Available as a Flatpak as well as a Debian package. The Flatpak
            carries its own runtime, so it installs on distributions whose
            system libraries are older than the .deb requires.
          </li>
          <li>
            The Flatpak runs with no network access at all. The game talks only
            to its own engine over the loopback interface inside the sandbox.
          </li>
          <li>
            Appears under Games, with a description, in application menus and
            software centres.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-04" />
  </releases>
</component>
