{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: tauri: ws: wss:; img-src 'self' data: asset: tauri:; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "Armchair Metropolist",
        "width": 1719,
        "height": 886,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "devUrl": "http://localhost:4000",
    "frontendDist": "http://localhost:4000"
  },
  "bundle": {
    "active": true,
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "SimulationGame",
    "externalBin": [
      "../burrito_out/desktop"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libc6 (>= 2.39)"],
        "recommends": ["libayatana-appindicator3-1"]
      }
    },
    "shortDescription": "City infrastructure simulator",
    "targets": "all"
  },
  "identifier": "io.github.adsouza.armchair-metropolist",
  "productName": "Armchair Metropolist",
  "version": "0.4.0"
}